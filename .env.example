# ─── Baba Solars website (frontend) — build-time settings ───────────────────
# Everything in VITE_* is PUBLIC: it is compiled into the browser JavaScript. Never put secrets here.
# Backend secrets live in server/.env (see server/.env.example).

# Public website URL used for canonical links and SEO tags.
VITE_SITE_URL=https://babasolars.com , localhost:8000

# API origin. Leave EMPTY when Nginx serves the website and proxies /api on the same domain (recommended).
# Set only if the API runs on another origin, e.g. https://api.babasolars.com (then add it to CORS_ORIGINS on the server).
VITE_API_URL=

# Build only: prerender pages from the live API so the HTML matches the database (npm run build:ssg).
# PRERENDER_API_URL=http://127.0.0.1:4000

# Development only: where `npm run dev` / `npm run preview` proxy /api and /uploads (default http://127.0.0.1:4000).
# API_PROXY_TARGET=http://127.0.0.1:4000

# ─── Website enquiries → Google Sheet + admin email (Google Apps Script, optional) ─────
# Paste the Web App URL from Apps Script → Deploy → Web app (it ends with /exec). See SETUP.md.
VITE_APPS_SCRIPT_URL=
# Same value as the API_TOKEN Script Property. Visible in the built JavaScript — blocks casual misuse only.
VITE_APPS_SCRIPT_TOKEN=
# "client" (default): the browser sends the Sheet row + email. "server": a backend does it.
# VITE_ENQUIRY_DELIVERY=client

